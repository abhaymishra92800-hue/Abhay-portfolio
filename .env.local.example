# ─────────────────────────────────────────────────────────────────
# LinkedIn Content Funnel — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────

# ── 1. GEMINI AI (Content Generation) ────────────────────────────
# Get your free API key at: https://aistudio.google.com/app/apikey
# Free tier: 1500 requests/day — more than enough to start
# Without this key: the system uses demo/mock content (still sends email)
GEMINI_API_KEY=

# ── 2. RESEND (Email Delivery) ────────────────────────────────────
# Get your API key at: https://resend.com (free: 3,000 emails/month)
# REQUIRED — without this key, NO emails will be sent
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The email address you send FROM
# Option A (Testing immediately): Use onboarding@resend.dev
#   → Can only deliver to the email you signed up to Resend with
# Option B (Production): Use your own domain e.g. abhayworkofficial@gmail.com
#   → Requires DNS verification at resend.com/domains (takes ~5 min)
RESEND_FROM_EMAIL=abhayworkofficial@gmail.com

# Resend Audience ID for the main "Abhay 4U Subscribers" list.
# Create one at resend.com/audiences, then copy the ID here.
# Without this, the /api/email/subscribe route skips list-add but still
# sends the welcome email and saves to Firestore.
RESEND_AUDIENCE_ID=

# Your own email — gets a BCC copy of every submission (your lead log)
ADMIN_EMAIL=abhayworkofficial@gmail.com

# ── 3. GOOGLE SHEETS (Lead Storage) ──────────────────────────────
# Optional but recommended — stores every submission in a Google Sheet
# Setup: See google-apps-script.js in this folder for instructions
# Without this: leads are still logged to your inbox via ADMIN_EMAIL BCC
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# =====================================================================
# PHASE 3 - Nurture + Analytics (ANUA-20)
# =====================================================================

# 4. FIREBASE ADMIN (Server-side) - Required for the 3-email nurture queue
# Used by app/api/cron/nurture to enqueue & send the welcome sequence.
# Create a service account: Firebase Console > Project Settings > Service accounts > Generate new private key
# Then encode the private key (replace newlines with \n). Leave empty to disable the nurture queue.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# 5. PLAUSIBLE ANALYTICS (Privacy-friendly, cookieless)
# Set to your site domain (e.g. abhay-editing-portfolio-website.vercel.app) to enable Plausible after cookie consent.
# Leave empty to disable analytics.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# 6. VERCEL CRON SECRET (Protects app/api/cron/nurture)
# Vercel sends this as an Authorization: Bearer header on each cron invocation.
# Recommend using openssl rand -base64 32. Leave empty to leave the route open (local dev).
CRON_SECRET=